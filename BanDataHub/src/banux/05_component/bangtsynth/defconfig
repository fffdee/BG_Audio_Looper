#
# BanGTsynth Default Configuration
#

#
# Platform Selection
#
CONFIG_PLATFORM_LINUX=y
# CONFIG_PLATFORM_STM32 is not set
# CONFIG_PLATFORM_ESP32 is not set
# CONFIG_PLATFORM_CUSTOM is not set

#
# Audio Configuration
#
CONFIG_SAMPLE_RATE=48000
CONFIG_MAX_CHANNELS=2
CONFIG_AUDIO_BIT_DEPTH=16
CONFIG_MAX_POLYPHONY=32

#
# Feature Modules
#
CONFIG_ENABLE_MIDI_CONTROLLER=y
CONFIG_ENABLE_MIXER=y
CONFIG_MAX_MIX_COUNT=10
CONFIG_ENABLE_ENVELOPE_GEN=y
CONFIG_ENABLE_SEQUENCER=n

#
# Input/Output Options
#
# CONFIG_ENABLE_USB_MIDI is not set
CONFIG_ENABLE_KEYBOARD_INPUT=y
# CONFIG_ENABLE_SERIAL_MIDI is not set

#
# Storage Configuration
#
CONFIG_MAX_FILE_COUNT=100
CONFIG_WAV_START_ADDRESS=0x19000

#
# Buffer Configuration
#
CONFIG_BUFFER_SIZE=48
CONFIG_RING_BUFFER_MULTIPLIER=2

#
# Debug Options
#
# CONFIG_DEBUG_ENABLED is not set
# CONFIG_READ_DEBUG is not set
# CONFIG_MIDI_DEBUG is not set

#
# Advanced Options
#
# CONFIG_USE_STATIC_MEMORY is not set
# CONFIG_ENABLE_PROFILING is not set
