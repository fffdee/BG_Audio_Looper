<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#303030"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    
    <!-- 按下状态 - 青色高亮 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00D9FF"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#1A4A6A"
                        android:endColor="#0F2940"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 正常状态 - 深蓝带青色光环 -->
    <item>
        <layer-list>
            <!-- 外层青色光环 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00D9FF"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <!-- 内层深蓝渐变 -->
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#0F3550"
                        android:endColor="#0A1F30"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
