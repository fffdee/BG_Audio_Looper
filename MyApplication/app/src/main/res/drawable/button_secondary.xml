<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#C0C0C0"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0097B2"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#D0D8E8"
                        android:endColor="#C0C8D8"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 正常状态 - 浅色带青色光环 -->
    <item>
        <layer-list>
            <!-- 外层青色光环 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0097B2"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <!-- 内层浅色渐变 -->
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#E8EDF5"
                        android:endColor="#DCE2EE"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
