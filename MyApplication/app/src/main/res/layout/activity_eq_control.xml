<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/primary_darker"
        android:elevation="@dimen/card_elevation"
        android:paddingStart="@dimen/toolbar_padding"
        android:paddingEnd="@dimen/toolbar_padding">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/text_primary"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="均衡器设置"
            android:textSize="@dimen/text_size_xlarge"
            android:textColor="@color/text_accent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="保存"
            android:textColor="@color/primary_darker"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:background="@drawable/button_glow"
            android:paddingStart="@dimen/button_padding_horizontal"
            android:paddingEnd="@dimen/button_padding_horizontal"
            android:elevation="@dimen/card_elevation" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/toolbar_padding">

            <!-- EQ 控制卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="@dimen/toolbar_padding"
                android:elevation="@dimen/card_elevation">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️ 均衡器设置"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textColor="@color/text_accent"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <!-- 节点选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ 节点："
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_node"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:background="@android:drawable/btn_dropdown"
                        android:backgroundTint="@color/bg_card"
                        android:popupBackground="@color/primary_darker"
                        android:theme="@style/SpinnerTheme" />
                </LinearLayout>

                <!-- EQ 曲线图 -->
                <com.example.myapplication.EqCurveView
                    android:id="@+id/eq_curve_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginVertical="12dp" />

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/primary_accent"
                    android:alpha="0.3"
                    android:layout_marginVertical="@dimen/spacing_small" />

                <!-- Band 选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_small">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="频段："
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_band"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:background="@android:drawable/btn_dropdown"
                        android:backgroundTint="@color/bg_card"
                        android:popupBackground="@color/primary_darker"
                        android:theme="@style/SpinnerTheme" />

                    <Button
                        android:id="@+id/btn_add_band"
                        android:layout_width="@dimen/button_height_medium"
                        android:layout_height="@dimen/button_height_medium"
                        android:text="+"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textColor="@color/primary_darker"
                        android:textStyle="bold"
                        android:background="@drawable/button_glow"
                        android:layout_marginStart="@dimen/spacing_small" />

                    <Button
                        android:id="@+id/btn_remove_band"
                        android:layout_width="@dimen/button_height_medium"
                        android:layout_height="@dimen/button_height_medium"
                        android:text="-"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textColor="@color/primary_darker"
                        android:background="@drawable/button_debug"
                        android:layout_marginStart="@dimen/spacing_tiny" />
                </LinearLayout>

                <!-- 启用开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_small"
                    android:background="@color/bg_dark"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:layout_marginVertical="@dimen/spacing_small">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="启用该频段"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/switch_band_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- 滤波器类型 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_small">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="滤波器类型"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_filter_type"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:background="@android:drawable/btn_dropdown"
                        android:backgroundTint="@color/bg_card"
                        android:popupBackground="@color/primary_darker"
                        android:theme="@style/SpinnerTheme" />
                </LinearLayout>

                <!-- 中心频率 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_small"
                    android:background="@color/bg_dark"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:layout_marginVertical="@dimen/spacing_tiny">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="中心频率"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_freq_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1000 Hz"
                            android:textColor="@color/primary_accent_glow"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_freq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:layout_marginTop="@dimen/spacing_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20Hz"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20kHz"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Q 值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_small"
                    android:background="@color/bg_dark"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:layout_marginVertical="@dimen/spacing_tiny">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Q 值 (带宽)"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_q_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.00"
                            android:textColor="@color/primary_accent_glow"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_q"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="490"
                        android:progress="90"
                        android:layout_marginTop="@dimen/spacing_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.1 (宽)"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50 (窄)"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 增益 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_small"
                    android:background="@color/bg_dark"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:layout_marginVertical="@dimen/spacing_tiny">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="增益"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_gain_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/primary_accent_glow"
                            android:textSize="@dimen/text_size_large"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_gain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="24"
                        android:progress="12"
                        android:layout_marginTop="@dimen/spacing_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-12 dB"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+12 dB"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
