<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:minWidth="600dp"
    android:padding="16dp">

    <!-- 标题区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BLE 设备扫描"
            android:textColor="@color/primary_accent_glow"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/slider_thumb"
            android:backgroundTint="@color/primary_accent_glow"
            android:layout_marginEnd="@dimen/spacing_tiny" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扫描中..."
            android:textColor="@color/text_warning"
            android:textSize="@dimen/text_size_body"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:backgroundTint="@color/primary_accent_glow"
        style="?android:attr/listDivider"
        android:alpha="0.3" />

    <!-- 设备列表 -->
    <ListView
        android:id="@+id/lv_devices"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@color/bg_dark"
        android:divider="@color/primary_accent_glow"
        android:dividerHeight="1dp"
        android:padding="@dimen/spacing_small"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_rescan"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="重新扫描" />

        <Button
            android:id="@+id/btn_close"
            style="@style/DebugButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="关闭" />
    </LinearLayout>
</LinearLayout>
