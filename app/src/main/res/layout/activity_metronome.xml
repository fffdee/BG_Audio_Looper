<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- 统一顶部导航栏 -->
    <include layout="@layout/include_base_toolbar" />

    <!-- 状态显示区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:padding="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_metronome_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 已停止"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_bpm_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120"
            android:textSize="48sp"
            android:textColor="@color/primary_accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BPM"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_beats_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/4"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- 控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn_metro_toggle"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="启动"
            android:textSize="18sp"
            android:background="@drawable/button_connect" />

    </LinearLayout>

    <!-- 设置区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="节拍器设置"
                android:textSize="18sp"
                android:textColor="@color/text_accent"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- BPM 设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BPM (60-200)"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_bpm_minus"
                        style="@style/PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="-"
                        android:textSize="20sp" />

                    <SeekBar
                        android:id="@+id/seekbar_bpm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="140"
                        android:progress="60" />

                    <Button
                        android:id="@+id/btn_bpm_plus"
                        style="@style/PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 拍数设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每小节拍数 (2-8)"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_beats_minus"
                        style="@style/PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="-"
                        android:textSize="20sp" />

                    <SeekBar
                        android:id="@+id/seekbar_beats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="6"
                        android:progress="2" />

                    <Button
                        android:id="@+id/btn_beats_plus"
                        style="@style/PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 音量设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音量 (0-100%)"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seekbar_volume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:max="100"
                        android:progress="80" />

                    <TextView
                        android:id="@+id/tv_volume_display"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="80%"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
