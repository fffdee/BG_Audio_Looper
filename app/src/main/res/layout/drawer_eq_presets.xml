<?xml version="1.0" encoding="utf-8"?>
<!-- EQ 预设侧边栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_presets"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:elevation="8dp"
    android:layout_gravity="end"
    android:visibility="gone">

    <!-- 侧边栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_darker"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EQ 预设"
            android:textSize="18sp"
            android:textColor="@color/text_accent"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_drawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_primary"
            android:contentDescription="关闭" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/primary_accent"
        android:alpha="0.3" />

    <!-- 当前节点显示 -->
    <TextView
        android:id="@+id/tv_current_node"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前节点：乐器左声道"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:padding="16dp"
        android:gravity="center" />

    <!-- 预设列表 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 预设槽位 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 1"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设1"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_1_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_1_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- 预设槽位 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 2"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设2"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_2_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_2_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- 预设槽位 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 3"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_3"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设3"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_3_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_3_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- 预设槽位 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_4_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 4"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_4"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设4"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_4_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_4_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- 预设槽位 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_5_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 5"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_5"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设5"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_5_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_5_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

            <!-- 预设槽位 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_preset_6_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设 6"
                        android:textSize="16sp"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <ImageButton
                        android:id="@+id/btn_reset_preset_6"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="@color/text_secondary"
                        android:contentDescription="重置预设6"
                        android:scaleType="centerInside"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击名称可编辑"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_drawer_preset_6_load"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="加载"
                        android:textSize="14sp"
                        android:background="@drawable/button_connect" />

                    <Button
                        android:id="@+id/btn_drawer_preset_6_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:background="@drawable/button_glow" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
