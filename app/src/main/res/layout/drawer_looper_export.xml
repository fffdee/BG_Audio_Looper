<?xml version="1.0" encoding="utf-8"?>
<!--
    导出中心侧边栏（右侧滑入）
    - 段选择 + 自定义文件名 + 开始导出
    - 已导出历史文件列表（播放 / 删除）
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_looper_export"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:elevation="8dp"
    android:visibility="gone">

    <!-- 顶栏：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 导出中心"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_close_export_drawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ===== 导出 WAV 文件 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出 WAV 文件"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_accent"
                android:layout_marginBottom="10dp" />

            <!-- 段选择 -->
            <CheckBox
                android:id="@+id/cb_export_seg0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOOP 1"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_export_seg1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOOP 2"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_export_seg2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOOP 3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_export_seg3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOOP 4"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- 提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅支持时长相同的段同时混音导出"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <!-- 自定义文件名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文件名（选填，默认时间戳）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_export_filename"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="例：MyLoop_001"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginBottom="12dp" />

            <!-- 声道平衡 & 增益 -->
            <CheckBox
                android:id="@+id/cb_export_mono_mix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="声道平衡（立体声 → L=R=(L+R)/2）"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_export_gain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出增益：100%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/sb_export_gain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="100"
                android:layout_marginBottom="14dp" />

            <!-- 开始导出按钮 -->
            <Button
                android:id="@+id/btn_start_export"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="开始导出"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/button_primary"
                android:layout_marginBottom="16dp" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginBottom="12dp" />

            <!-- ===== 历史文件 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已导出文件"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_accent" />

                <Button
                    android:id="@+id/btn_refresh_wav_history"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="刷新"
                    android:textSize="11sp"
                    android:textColor="@color/bg_dark"
                    android:background="@drawable/button_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- 历史文件列表（动态填充） -->
            <LinearLayout
                android:id="@+id/container_wav_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
