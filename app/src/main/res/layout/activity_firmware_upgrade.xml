<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <include layout="@layout/include_base_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 设备信息卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设备信息"
                    android:textColor="@color/text_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="连接状态"
                        android:textColor="@color/label_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_ble_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未连接"
                        android:textColor="@color/text_error"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="协议版本:"
                        android:textColor="@color/label_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_protocol_ver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未获取"
                        android:textColor="@color/value_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="APP容量:"
                        android:textColor="@color/label_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_app_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未获取"
                        android:textColor="@color/value_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_query_info"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:text="查询设备信息"
                    android:textSize="13sp"
                    android:backgroundTint="@color/bg_card_light"
                    android:textColor="@color/text_accent" />
            </LinearLayout>

            <!-- 固件来源 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="固件来源"
                    android:textColor="@color/text_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_check_update"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="检查云端更新"
                        android:textSize="13sp"
                        android:backgroundTint="@color/primary_accent"
                        android:textColor="@color/on_surface_color" />

                    <Button
                        android:id="@+id/btn_select_file"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="选择本地文件"
                        android:textSize="13sp"
                        android:backgroundTint="@color/bg_card_light"
                        android:textColor="@color/text_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未选择固件"
                    android:textColor="@color/label_secondary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_file_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/label_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_cloud_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 升级进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="升级进度"
                    android:textColor="@color/text_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary_accent"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_progress_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="等待开始"
                        android:textColor="@color/value_text"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_progress_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/primary_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 日志输出 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日志"
                    android:textColor="@color/text_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:id="@+id/scroll_log"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@color/log_bg"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/tv_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/log_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:padding="12dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_start_upgrade"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="开始升级"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_accent"
            android:textColor="@color/on_surface_color"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_reboot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="重启设备"
            android:textSize="13sp"
            android:backgroundTint="@color/rollback_btn_bg"
            android:textColor="@color/rollback_btn_text"
            android:enabled="false" />

        <!-- 设置按钮 -->
        <ImageButton
            android:id="@+id/btn_ota_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_accent"
            android:contentDescription="OTA 设置" />
    </LinearLayout>

    </LinearLayout><!-- 主内容区结束 -->

    <!-- OTA 设置侧边栏（覆盖层，滑入自右侧） -->
    <include layout="@layout/drawer_ota_settings" />

</FrameLayout>
