<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#C0C0C0" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#D0D4E0" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#88BB55" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 正常状态 - 浅色渐变+绿色边框 -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#E8EDF5"
                        android:centerColor="#DCE2EE"
                        android:endColor="#D0D8E8"
                        android:type="linear" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#88DD66" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>