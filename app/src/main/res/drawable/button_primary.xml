<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#C0C0C0"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00A366"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#0097B2"
                        android:centerColor="#0088A0"
                        android:endColor="#007090"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 正常状态 - 青色渐变 -->
    <item>
        <layer-list>
            <!-- 外层阴影 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#300097B2"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <!-- 渐变主体 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#0097B2"
                        android:centerColor="#0088A0"
                        android:endColor="#007090"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
