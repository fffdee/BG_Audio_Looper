<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态：填充更亮 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#50CCA030"/>
            <stroke android:width="1dp" android:color="#CCA030"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <!-- 正常状态：半透明琥珀边框 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18CCA030"/>
            <stroke android:width="1dp" android:color="#70CCA030"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
