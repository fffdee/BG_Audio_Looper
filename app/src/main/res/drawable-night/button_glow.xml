<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3D3D3D" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00AA66" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 正常状态 - 绿色渐变+强发光 -->
    <item>
        <layer-list>
            <!-- 强发光外层 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6000FFA3" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <!-- 渐变主体 -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#00FFA3"
                        android:centerColor="#00CC88"
                        android:endColor="#009966"
                        android:type="linear" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
