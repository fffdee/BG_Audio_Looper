/**
 * @file    ui_core.h
 * @brief   UI Core - State Management and Event Coordination
 * @author  BG Card Team
 * @date    2025-01-08
 * 
 * UI System Architecture:
 * 
 *   ┌─────────────────────────────────────────────────────────────┐
 *   │                      Application Layer                      │
 *   │  (Page System, Looper, Audio Manager, etc.)                │
 *   └─────────────────────────────┬───────────────────────────────┘
 *                                 │
 *   ┌─────────────────────────────▼───────────────────────────────┐
 *   │                      UI Core (ui_core.h)                    │
 *   │  - State Machine                                            │
 *   │  - Event Dispatcher                                         │
 *   │  - View Manager                                             │
 *   └────────┬─────────────────────────────────────┬──────────────┘
 *            │                                     │
 *   ┌────────▼────────┐                   ┌───────▼────────┐
 *   │   Input Layer   │                   │   View Layer   │
 *   │  - ui_button    │                   │  - ui_statusbar│
 *   │  - (touch/knob) │                   │  - ui_menu     │
 *   └─────────────────┘                   │  - ui_popup    │
 *                                         │  - ui_home     │
 *                                         └────────────────┘
 * 
 * Key Concepts:
 *   - View: A drawable UI component (menu, statusbar, popup, etc.)
 *   - Scene: A collection of views that form a complete screen
 *   - State: Current UI mode (IDLE, MENU, POPUP, etc.)
 */

#ifndef __UI_CORE_H__
#define __UI_CORE_H__

#include <stdint.h>
#include <stdbool.h>
#include "ui_config.h"
#include "ui_button.h"

#ifdef __cplusplus
extern "C" {
#endif

/*===========================================================================
 * UI State Definitions
 *===========================================================================*/

/**
 * @brief UI System State
 */
typedef enum {
    UI_STATE_BOOT = 0,      /* Boot/Splash screen */
    UI_STATE_IDLE,          /* Main idle screen (home) */
    UI_STATE_MENU,          /* Menu navigation */
    UI_STATE_POPUP,         /* Modal popup dialog */
    UI_STATE_PLAYER,        /* Audio player view */
    UI_STATE_LOOPER,        /* Looper control view */
    UI_STATE_SETTINGS,      /* Settings view */
    UI_STATE_CUSTOM,        /* Custom view (for extensions) */
    UI_STATE_COUNT
} UI_State_t;

/**
 * @brief UI Event Types
 */
typedef enum {
    UI_EVENT_NONE = 0,
    UI_EVENT_BUTTON,        /* Button event */
    UI_EVENT_TIMER,         /* Timer tick event */
    UI_EVENT_STATE_CHANGE,  /* State changed event */
    UI_EVENT_REFRESH,       /* Refresh request */
    UI_EVENT_DATA_UPDATE,   /* Data updated (e.g., volume changed) */
    UI_EVENT_CUSTOM,        /* Custom event */
} UI_EventType_t;

/**
 * @brief UI Event Data
 */
typedef struct {
    UI_EventType_t type;
    union {
        UI_ButtonEventData_t button;    /* Button event data */
        struct {
            UI_State_t from;
            UI_State_t to;
        } state_change;                 /* State change data */
        uint32_t custom;                /* Custom event data */
    } data;
} UI_Event_t;

/*===========================================================================
 * View Interface
 *===========================================================================*/

/**
 * @brief View lifecycle callbacks
 */
typedef struct UI_View {
    const char* name;                   /* View name for debugging */
    
    /* Lifecycle callbacks */
    void (*on_create)(void);            /* Called when view is created */
    void (*on_destroy)(void);           /* Called when view is destroyed */
    void (*on_enter)(void);             /* Called when view becomes active */
    void (*on_exit)(void);              /* Called when view becomes inactive */
    
    /* Update and draw */
    void (*on_update)(uint16_t delta_ms);   /* Called every tick */
    void (*on_draw)(void);                  /* Called when redraw needed */
    
    /* Event handling */
    bool (*on_event)(UI_Event_t* event);    /* Returns true if event consumed */
    
    /* View properties */
    bool visible;                       /* Is view visible */
    bool needs_redraw;                  /* Needs redraw flag */
    uint8_t z_order;                    /* Z-order for layering */
} UI_View_t;

/*===========================================================================
 * Scene Interface
 *===========================================================================*/

#define UI_MAX_VIEWS_PER_SCENE  8

/**
 * @brief Scene - a collection of views
 */
typedef struct {
    const char* name;
    UI_View_t* views[UI_MAX_VIEWS_PER_SCENE];
    uint8_t view_count;
    UI_State_t state;                   /* Associated UI state */
} UI_Scene_t;

/*===========================================================================
 * Event Handler Registration
 *===========================================================================*/

/**
 * @brief Global event handler callback
 * @param event The event to handle
 * @return true if event was consumed, false to continue propagation
 */
typedef bool (*UI_EventHandler_t)(UI_Event_t* event);

/**
 * @brief State change callback
 */
typedef void (*UI_StateChangeCallback_t)(UI_State_t from, UI_State_t to);

/*===========================================================================
 * Core API Functions
 *===========================================================================*/

/**
 * @brief Initialize UI Core
 */
void UI_Core_Init(void);

/**
 * @brief Start UI Core (begin state machine)
 * @param initial_state Starting state
 */
void UI_Core_Start(UI_State_t initial_state);

/**
 * @brief Update UI Core (call in main loop)
 * @param delta_ms Milliseconds since last update
 */
void UI_Core_Update(uint16_t delta_ms);

/**
 * @brief Request a state transition
 * @param new_state Target state
 * @return true if transition allowed
 */
bool UI_Core_SetState(UI_State_t new_state);

/**
 * @brief Get current state
 * @return Current UI state
 */
UI_State_t UI_Core_GetState(void);

/**
 * @brief Get previous state
 * @return Previous UI state
 */
UI_State_t UI_Core_GetPrevState(void);

/**
 * @brief Request full redraw
 */
void UI_Core_Invalidate(void);

/**
 * @brief Check if UI is ready (boot complete)
 * @return true if ready
 */
bool UI_Core_IsReady(void);

/*===========================================================================
 * View Management
 *===========================================================================*/

/**
 * @brief Register a view for a state
 * @param state UI state
 * @param view View to register
 */
void UI_Core_RegisterView(UI_State_t state, UI_View_t* view);

/**
 * @brief Unregister a view
 * @param view View to unregister
 */
void UI_Core_UnregisterView(UI_View_t* view);

/**
 * @brief Get active views for current state
 * @param views Output array of view pointers
 * @param max_count Maximum views to return
 * @return Number of active views
 */
uint8_t UI_Core_GetActiveViews(UI_View_t** views, uint8_t max_count);

/*===========================================================================
 * Event Management
 *===========================================================================*/

/**
 * @brief Post an event to UI Core
 * @param event Event to post
 */
void UI_Core_PostEvent(UI_Event_t* event);

/**
 * @brief Process a button event
 * @param btn_event Button event data
 */
void UI_Core_HandleButton(UI_ButtonEventData_t* btn_event);

/**
 * @brief Register global event handler
 * @param handler Handler callback
 * @param priority Handler priority (higher = earlier)
 */
void UI_Core_RegisterEventHandler(UI_EventHandler_t handler, uint8_t priority);

/**
 * @brief Unregister global event handler
 * @param handler Handler to unregister
 */
void UI_Core_UnregisterEventHandler(UI_EventHandler_t handler);

/**
 * @brief Register state change callback
 * @param callback Callback function
 */
void UI_Core_OnStateChange(UI_StateChangeCallback_t callback);

/*===========================================================================
 * Popup Management
 *===========================================================================*/

/**
 * @brief Show a popup message
 * @param title Popup title
 * @param message Popup message
 * @param duration_ms Auto-close duration (0 = manual close)
 * @param on_close Callback when popup closes (optional)
 */
void UI_Core_ShowPopup(const char* title, const char* message, 
                       uint16_t duration_ms, void (*on_close)(void));

/**
 * @brief Close current popup
 */
void UI_Core_ClosePopup(void);

/**
 * @brief Check if popup is active
 * @return true if popup is showing
 */
bool UI_Core_IsPopupActive(void);

/*===========================================================================
 * Utility Functions
 *===========================================================================*/

/**
 * @brief Get state name string
 * @param state UI state
 * @return State name string
 */
const char* UI_Core_GetStateName(UI_State_t state);

/**
 * @brief Enable/disable debug output
 * @param enable Enable flag
 */
void UI_Core_SetDebug(bool enable);

#ifdef __cplusplus
}
#endif

#endif /* __UI_CORE_H__ */
