/**
 * @file    page_ui_bridge.h
 * @brief   Page System and UI System Event Bridge
 * @author  BG Card Team
 * @date    2025-06-21
 * 
 * This module bridges the BG_Page system with the UI_System,
 * providing unified button event distribution and state management.
 * 
 * Features:
 *   - Unified button event handling
 *   - Page system and UI system coordination
 *   - Priority-based event routing (popup > menu > page)
 *   - Seamless state transitions
 * 
 * Button Mapping:
 *   UI_BTN_UP    (GPIO_A0)  -> BG_page.Last  / Menu Up
 *   UI_BTN_DOWN  (GPIO_B5)  -> BG_page.Next  / Menu Down
 *   UI_BTN_ENTER (GPIO_A15) -> BG_page.Enter / Menu Enter
 *   UI_BTN_BACK  (GPIO_A16) -> BG_page.Exit  / Menu Back
 */

#ifndef __PAGE_UI_BRIDGE_H__
#define __PAGE_UI_BRIDGE_H__

#include <stdint.h>
#include <stdbool.h>
#include "bg_page.h"
#include "../ui_system/ui_button.h"
#include "../ui_system/ui_core.h"

#ifdef __cplusplus
extern "C" {
#endif

/*===========================================================================
 * Bridge Mode Definitions
 *===========================================================================*/

/**
 * @brief Bridge operating mode
 * Determines how button events are routed
 */
typedef enum {
    BRIDGE_MODE_PAGE = 0,       /* Events go to Page system (BG_page) */
    BRIDGE_MODE_UI,             /* Events go to UI system (UI_System) */
    BRIDGE_MODE_AUTO,           /* Auto-route based on UI state */
    BRIDGE_MODE_DISABLED,       /* Events are ignored */
} PageUI_BridgeMode_t;

/**
 * @brief Event handler priority
 */
typedef enum {
    BRIDGE_PRIORITY_LOW = 0,    /* Low priority handler */
    BRIDGE_PRIORITY_NORMAL,     /* Normal priority handler */
    BRIDGE_PRIORITY_HIGH,       /* High priority handler (popup, etc.) */
} PageUI_BridgePriority_t;

/**
 * @brief Bridge configuration
 */
typedef struct {
    PageUI_BridgeMode_t mode;           /* Operating mode */
    bool enable_page_callbacks;         /* Enable page system callbacks */
    bool enable_ui_callbacks;           /* Enable UI system callbacks */
    bool long_press_to_exit;           /* Long press BACK to exit menu */
    uint16_t update_interval_ms;        /* Update interval (ms) */
} PageUI_BridgeConfig_t;

/**
 * @brief Bridge statistics for debugging
 */
typedef struct {
    uint32_t total_events;              /* Total events processed */
    uint32_t page_events;               /* Events routed to Page system */
    uint32_t ui_events;                 /* Events routed to UI system */
    uint32_t ignored_events;            /* Events ignored */
} PageUI_BridgeStats_t;

/*===========================================================================
 * Custom Event Handler Callback
 *===========================================================================*/

/**
 * @brief Custom event handler callback type
 * @param event Button event data
 * @return true if event was consumed, false to pass to default handler
 */
typedef bool (*PageUI_EventHandler_t)(UI_ButtonEventData_t* event);

/*===========================================================================
 * API Functions
 *===========================================================================*/

/**
 * @brief Initialize the Page-UI Bridge
 * @param page Pointer to the BG_Page instance
 * @param config Bridge configuration, NULL for default
 */
void PageUI_Bridge_Init(BG_Page* page, const PageUI_BridgeConfig_t* config);

/**
 * @brief Set bridge operating mode
 * @param mode New operating mode
 */
void PageUI_Bridge_SetMode(PageUI_BridgeMode_t mode);

/**
 * @brief Get current bridge operating mode
 * @return Current mode
 */
PageUI_BridgeMode_t PageUI_Bridge_GetMode(void);

/**
 * @brief Bridge update function (call in main loop)
 * @param delta_ms Time elapsed since last call (ms)
 * 
 * This function:
 *   1. Scans buttons (calls UI_Button_Scan)
 *   2. Gets button events (calls UI_Button_GetEvent)
 *   3. Routes events to Page or UI system based on mode
 *   4. Calls page loop if in PAGE mode
 */
void PageUI_Bridge_Update(uint16_t delta_ms);

/**
 * @brief Process a single button event
 * @param event Button event to process
 * 
 * Manually process an event through the bridge.
 * Useful for testing or injecting events.
 */
void PageUI_Bridge_ProcessEvent(UI_ButtonEventData_t* event);

/**
 * @brief Register custom event handler
 * @param handler Custom handler function
 * @param priority Handler priority
 * 
 * Custom handlers are called before default routing.
 * If handler returns true, event is consumed.
 */
void PageUI_Bridge_RegisterHandler(PageUI_EventHandler_t handler, 
                                    PageUI_BridgePriority_t priority);

/**
 * @brief Unregister custom event handler
 * @param handler Handler to remove
 */
void PageUI_Bridge_UnregisterHandler(PageUI_EventHandler_t handler);

/**
 * @brief Switch to Page system control
 * @param page_id Target page ID to switch to
 */
void PageUI_Bridge_SwitchToPage(uint8_t page_id);

/**
 * @brief Switch to UI system control
 * @param state Target UI state
 */
void PageUI_Bridge_SwitchToUI(UI_State_t state);

/**
 * @brief Check if Page system is active
 * @return true if Page system is handling events
 */
bool PageUI_Bridge_IsPageActive(void);

/**
 * @brief Check if UI system is active
 * @return true if UI system is handling events
 */
bool PageUI_Bridge_IsUIActive(void);

/**
 * @brief Get bridge statistics
 * @return Pointer to statistics structure
 */
const PageUI_BridgeStats_t* PageUI_Bridge_GetStats(void);

/**
 * @brief Reset bridge statistics
 */
void PageUI_Bridge_ResetStats(void);

/**
 * @brief Enable/disable Page system loop
 * @param enable Enable flag
 * 
 * When enabled, Bridge_Update will call BG_page.Loop()
 */
void PageUI_Bridge_EnablePageLoop(bool enable);

/**
 * @brief Enable/disable UI system update
 * @param enable Enable flag
 * 
 * When enabled, Bridge_Update will call UI_System_Update()
 */
void PageUI_Bridge_EnableUIUpdate(bool enable);

/**
 * @brief Get the current BG_Page instance
 * @return Pointer to BG_Page
 */
BG_Page* PageUI_Bridge_GetPage(void);

/**
 * @brief Map UI button event to Page button state
 * @param event UI button event
 * @param page BG_Page instance to update
 * 
 * Internal helper function - sets page pressed flags based on UI event.
 */
void PageUI_Bridge_MapEventToPage(UI_ButtonEventData_t* event, BG_Page* page);

#ifdef __cplusplus
}
#endif

#endif /* __PAGE_UI_BRIDGE_H__ */
