// 全局帧缓冲实例
static FrameBuffer g_framebuffer;

// 静态分配显存缓冲区 (20,480 * 2 = 40,960 字节 ≈ 40KB)
#ifndef USE_FRAME_BUFFER
static uint16_t framebuffer_memory[1];
#else
static uint16_t framebuffer_memory[ FB_SIZE];
#endif
// 初始化帧缓冲
void FrameBuffer_Init(void) {
    g_framebuffer.buffer = framebuffer_memory;
    g_framebuffer.dirty = 0;
    g_framebuffer.dirty_x1 = FB_WIDTH;
    g_framebuffer.dirty_y1 = FB_HEIGHT;
    g_framebuffer.dirty_x2 = 0;
    g_framebuffer.dirty_y2 = 0;
    
    // 初始化为黑色
    memset(framebuffer_memory, 0, FB_SIZE * sizeof(uint16_t));
}

// 清屏 - 只操作内存
void FrameBuffer_Clear(uint16_t color) {
    uint16_t i;
    for (i = 0; i < FB_SIZE; i++) {
        g_framebuffer.buffer[i] = color;
    }
    
    // 标记整个屏幕为脏
    FrameBuffer_MarkDirty(0, 0, FB_WIDTH, FB_HEIGHT);
}

// 设置像素 - 只操作内存
void FrameBuffer_SetPixel(uint16_t x, uint16_t y, uint16_t color) {
    if (x >= FB_WIDTH || y >= FB_HEIGHT) return;
    
    g_framebuffer.buffer[y * FB_WIDTH + x] = color;
    FrameBuffer_MarkDirty(x, y, 1, 1);
}

// 获取像素
uint16_t FrameBuffer_GetPixel(uint16_t x, uint16_t y) {
    if (x >= FB_WIDTH || y >= FB_HEIGHT) return 0;
    return g_framebuffer.buffer[y * FB_WIDTH + x];
}

// 绘制直线 - 只操作内存
void FrameBuffer_DrawLine(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1, uint16_t color) {
    int16_t dx = x1 - x0;
    int16_t dy = y1 - y0;
    int16_t x_inc = (dx > 0) ? 1 : -1;
    int16_t y_inc = (dy > 0) ? 1 : -1;
    int16_t error, index;
    
    if (dx < 0) dx = -dx;
    if (dy < 0) dy = -dy;
    
    int16_t dx2 = dx << 1;
    int16_t dy2 = dy << 1;
    
    if (dx > dy) {
        error = dy2 - dx;
        for (index = 0; index <= dx; index++) {
            FrameBuffer_SetPixel(x0, y0, color);
            if (error >= 0) {
                error -= dx2;
                y0 += y_inc;
            }
            error += dy2;
            x0 += x_inc;
        }
    } else {
        error = dx2 - dy;
        for (index = 0; index <= dy; index++) {
            FrameBuffer_SetPixel(x0, y0, color);
            if (error >= 0) {
                error -= dy2;
                x0 += x_inc;
            }
            error += dx2;
            y0 += y_inc;
        }
    }
}

// 填充矩形 - 只操作内存，超高效
void FrameBuffer_FillRect(uint16_t x, uint16_t y, uint16_t width, uint16_t height, uint16_t color) {
    uint16_t x_end, y_end, row, col;
    
    // 边界检查
    if (x >= FB_WIDTH || y >= FB_HEIGHT) return;
    
    x_end = (x + width > FB_WIDTH) ? FB_WIDTH : x + width;
    y_end = (y + height > FB_HEIGHT) ? FB_HEIGHT : y + height;
    
    // 直接操作内存
    for (row = y; row < y_end; row++) {
        uint16_t* line_start = &g_framebuffer.buffer[row * FB_WIDTH + x];
        for (col = x; col < x_end; col++) {
            *line_start++ = color;
        }
    }
    
    FrameBuffer_MarkDirty(x, y, x_end - x, y_end - y);
}

// 绘制矩形边框
void FrameBuffer_DrawRect(uint16_t x, uint16_t y, uint16_t width, uint16_t height, uint16_t color) {
    // 上边框
    FrameBuffer_DrawLine(x, y, x + width - 1, y, color);
    // 下边框
    FrameBuffer_DrawLine(x, y + height - 1, x + width - 1, y + height - 1, color);
    // 左边框
    FrameBuffer_DrawLine(x, y, x, y + height - 1, color);
    // 右边框
    FrameBuffer_DrawLine(x + width - 1, y, x + width - 1, y + height - 1, color);
}

// 刷新整个屏幕到LCD - 使用最快的方法
void FrameBuffer_Flush(void) {
    extern void Lcd_SetRegion(uint16_t x_start, uint16_t y_start, uint16_t x_end, uint16_t y_end);
    extern void LCD_WriteData_16Bit(uint16_t Data);
    extern void Lcd_WriteIndex(uint8_t index);
    
    uint16_t i;
    
    // 设置整屏区域
    Lcd_SetRegion(0, 0, FB_WIDTH - 1, FB_HEIGHT - 1);
    Lcd_WriteIndex(0x2C);
    
    // 一次性传输整个帧缓冲
    for (i = 0; i < FB_SIZE; i++) {
        LCD_WriteData_16Bit(g_framebuffer.buffer[i]);
    }
    
    FrameBuffer_ClearDirty();
}

// 只刷新脏区域 (进一步优化)
void FrameBuffer_FlushDirty(void) {
    if (!g_framebuffer.dirty) return;
    
    extern void Lcd_SetRegion(uint16_t x_start, uint16_t y_start, uint16_t x_end, uint16_t y_end);
    extern void LCD_WriteData_16Bit(uint16_t Data);
    extern void Lcd_WriteIndex(uint8_t index);
    
    uint16_t x, y;
    
    // 设置脏区域
    Lcd_SetRegion(g_framebuffer.dirty_x1, g_framebuffer.dirty_y1,
                  g_framebuffer.dirty_x2, g_framebuffer.dirty_y2);
    Lcd_WriteIndex(0x2C);
    
    // 只传输脏区域
    for (y = g_framebuffer.dirty_y1; y <= g_framebuffer.dirty_y2; y++) {
        for (x = g_framebuffer.dirty_x1; x <= g_framebuffer.dirty_x2; x++) {
            LCD_WriteData_16Bit(g_framebuffer.buffer[y * FB_WIDTH + x]);
        }
    }
    
    FrameBuffer_ClearDirty();
}

// 标记脏区域
void FrameBuffer_MarkDirty(uint16_t x, uint16_t y, uint16_t width, uint16_t height) {
    uint16_t x2 = x + width - 1;
    uint16_t y2 = y + height - 1;
    
    if (x >= FB_WIDTH || y >= FB_HEIGHT) return;
    
    if (x2 >= FB_WIDTH) x2 = FB_WIDTH - 1;
    if (y2 >= FB_HEIGHT) y2 = FB_HEIGHT - 1;
    
    if (!g_framebuffer.dirty) {
        // 第一次标记脏区域
        g_framebuffer.dirty_x1 = x;
        g_framebuffer.dirty_y1 = y;
        g_framebuffer.dirty_x2 = x2;
        g_framebuffer.dirty_y2 = y2;
        g_framebuffer.dirty = 1;
    } else {
        // 扩展脏区域
        if (x < g_framebuffer.dirty_x1) g_framebuffer.dirty_x1 = x;
        if (y < g_framebuffer.dirty_y1) g_framebuffer.dirty_y1 = y;
        if (x2 > g_framebuffer.dirty_x2) g_framebuffer.dirty_x2 = x2;
        if (y2 > g_framebuffer.dirty_y2) g_framebuffer.dirty_y2 = y2;
    }
}

// 清除脏标记
void FrameBuffer_ClearDirty(void) {
    g_framebuffer.dirty = 0;
    g_framebuffer.dirty_x1 = FB_WIDTH;
    g_framebuffer.dirty_y1 = FB_HEIGHT;
    g_framebuffer.dirty_x2 = 0;
    g_framebuffer.dirty_y2 = 0;
}

// 获取帧缓冲指针 (高级用法)
uint16_t* FrameBuffer_GetBuffer(void) {
    return g_framebuffer.buffer;
}

// 绘制图像 - 支持菜单图标
void FrameBuffer_DrawImage(uint16_t x, uint16_t y, uint16_t width, uint16_t height, const uint8_t* image_data) {
    uint16_t row, col, pixel_index = 0;
    uint16_t color;
    
    // 边界检查
    if (x >= FB_WIDTH || y >= FB_HEIGHT || !image_data) return;
    
    uint16_t x_end = (x + width > FB_WIDTH) ? FB_WIDTH : x + width;
    uint16_t y_end = (y + height > FB_HEIGHT) ? FB_HEIGHT : y + height;
    
    // 绘制图像数据
    for (row = y; row < y_end; row++) {
        for (col = x; col < x_end; col++) {
            // 从image_data中读取RGB565格式的像素数据
            uint8_t high_byte = image_data[pixel_index * 2];
            uint8_t low_byte = image_data[pixel_index * 2 + 1];
            color = (high_byte << 8) | low_byte;
            
            g_framebuffer.buffer[row * FB_WIDTH + col] = color;
            pixel_index++;
        }
    }
    
    FrameBuffer_MarkDirty(x, y, x_end - x, y_end - y);
}

// 快速填充菜单项背景色块
void FrameBuffer_FillMenuRect(uint16_t x, uint16_t y, uint16_t width, uint16_t height, uint16_t color) {
    // 这是FrameBuffer_FillRect的优化版本，专门用于菜单
    FrameBuffer_FillRect(x, y, width, height, color);
}

// 绘制菜单边框 - 分四边绘制，避免覆盖图标
void FrameBuffer_DrawMenuBorder(uint16_t x, uint16_t y, uint16_t width, uint16_t height, uint16_t color, uint16_t border_width) {
    // 上边框
    FrameBuffer_FillRect(x, y, width, border_width, color);
    // 下边框
    FrameBuffer_FillRect(x, y + height - border_width, width, border_width, color);
    // 左边框
    FrameBuffer_FillRect(x, y, border_width, height, color);
    // 右边框
    FrameBuffer_FillRect(x + width - border_width, y, border_width, height, color);
}

