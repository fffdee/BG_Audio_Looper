#ifndef __UI_VIEW_HOME_H__
#define __UI_VIEW_HOME_H__

#include "ui_core.h"

#ifdef __cplusplus
extern "C" {
#endif

/*===========================================================================
 * Home View Configuration
 *===========================================================================*/

#define HOME_ICON_COUNT     4       /* Number of icons */
#define HOME_ICON_WIDTH     32      /* Icon width */
#define HOME_ICON_HEIGHT    32      /* Icon height */
#define HOME_ICON_SPACING   40      /* Spacing between icons */

/*===========================================================================
 * Home View API
 *===========================================================================*/

/**
 * @brief Get Home View instance
 * @return Pointer to Home View
 */
UI_View_t* UI_View_Home_Get(void);

/**
 * @brief Initialize Home View
 */
void UI_View_Home_Init(void);

/**
 * @brief Get currently selected icon index
 * @return Selected icon index (0-3)
 */
uint8_t UI_View_Home_GetSelected(void);

/**
 * @brief Set selected icon
 * @param index Icon index to select
 */
void UI_View_Home_SetSelected(uint8_t index);

/**
 * @brief Set icon callback
 * @param index Icon index
 * @param callback Callback function
 */
void UI_View_Home_SetIconCallback(uint8_t index, void (*callback)(void));

#ifdef __cplusplus
}
#endif

#endif /* __UI_VIEW_HOME_H__ */
